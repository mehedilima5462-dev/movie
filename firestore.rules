rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to verify if user has admin claim or is in the admin list
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@moviehubbd.com' ||
        request.auth.token.email == 'mehedilima5462@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Movies collection:
    // Public can read published movies. Admins can read all and manage.
    match /movies/{movieId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
      // Allow atomic view increments by public users
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Genres & Languages configuration
    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // User favorites collection
    // Document ID is often `{userId}_{movieId}` or subcollection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User watch history collection
    match /watchHistory/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Advertisement collection:
    // Public can read active ads. Public can update impression/click metrics. Admin has full control.
    match /ads/{adId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']);
    }

    // Advertisement telemetry events
    match /adEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

