# MovieHub BD - Environment Configuration Template
# For Hosting.com / cPanel / Shared Hosting:
# When building for production with `npm run build`, Vite will embed these VITE_ prefixed
# variables into the static dist bundle. Ensure you configure these before running `npm run build`.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional custom site URL for sitemaps and canonical tags
VITE_SITE_URL="https://moviehubbd.com"
